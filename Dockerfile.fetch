FROM python:3.11-slim
WORKDIR /app

# Added 'requests' to call one_scrape on localhost:3000/mcp
RUN pip install --no-cache-dir \
    mcp requests trafilatura flashrank

RUN python -c "from flashrank import Ranker; \
    Ranker('ms-marco-MiniLM-L-12-v2', cache_dir='/opt/flashrank')"

COPY fetch_rerank_server.py .
EXPOSE 3001
ENTRYPOINT ["python", "fetch_rerank_server.py"]
